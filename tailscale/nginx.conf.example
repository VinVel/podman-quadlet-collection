# Host NGINX. Merge this http block into the host's existing http block.
# Headscale serves UDP/3478 directly; NGINX handles HTTPS only.

http {
    upstream headplane_headscale {
        server 127.0.0.1:8990;
    }
    upstream headplane_ui {
        server 127.0.0.1:8991;
    }

    # Headscale's Tailscale Control Protocol uses a POST upgrade with a custom
    # Upgrade value; pass the original value rather than hard-coding websocket.
    map $http_upgrade $headplane_connection_upgrade {
        default upgrade;
        '' close;
    }

    server {
        listen 443 ssl;
        http2 on;
        server_name headscale.example.com;

        ssl_certificate /etc/letsencrypt/live/headscale.example.com/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/headscale.example.com/privkey.pem;

        # Tailscale captive portal probe.
        location = /generate_204 {
            return 204;
        }

        location / {
            # Headscale is the control server. Allow the separate Headplane
            # browser origin to call its API, including CORS preflights.
            add_header Access-Control-Allow-Origin https://heaplane.example.com always;
            add_header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS" always;
            add_header Access-Control-Allow-Headers $http_access_control_request_headers always;
            add_header Access-Control-Allow-Credentials true always;
            add_header Access-Control-Max-Age 100 always;
            add_header Vary Origin always;
            if ($request_method = OPTIONS) {
                return 204;
            }

            proxy_pass http://headplane_headscale;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $headplane_connection_upgrade;
            # NGINX is the sole public proxy: replace any client-supplied IP.
            proxy_set_header True-Client-IP $remote_addr;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto https;
            proxy_buffering off;
            proxy_read_timeout 1h;
        }
    }

    server {
        listen 443 ssl;
        http2 on;
        server_name heaplane.example.com;

        ssl_certificate /etc/letsencrypt/live/heaplane.example.com/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/heaplane.example.com/privkey.pem;

        location = / {
            return 308 /admin/;
        }

        location = /admin {
            return 308 /admin/;
        }

        location /admin/ {
            proxy_pass http://headplane_ui;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $headplane_connection_upgrade;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto https;
            proxy_buffering off;
        }
    }
}
